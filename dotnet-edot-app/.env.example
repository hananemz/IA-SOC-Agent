# EDOT .NET - Required OpenTelemetry environment variables

# Service name shown in Kibana
OTEL_SERVICE_NAME=mon-app-dotnet

# OTLP endpoint (managed OTLP endpoint or EDOT Collector)
# Example Elastic Cloud: https://proj-name.xxx.us-east-1.aws.cloud.es.io:443
OTEL_EXPORTER_OTLP_ENDPOINT=

# Authentication header
OTEL_EXPORTER_OTLP_HEADERS=Authorization=ApiKey <your-api-key>
