<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.0</version>
    <relativePath/>
  </parent>

  <groupId>com.example</groupId>
  <artifactId>java-edot-app</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>java-edot-app</name>
  <description>Flask Spring Boot instrumenté avec EDOT Java</description>

  <properties>
    <java.version>17</java.version>
    <!-- ⚠️ Version non vérifiée - remplacez par une version officielle EDOT -->
    <elastic-otel-java.version>99.99.99</elastic-otel-java.version>
  </properties>

  <dependencies>
    <!-- Spring Boot starters -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- EDOT Java auto-instrumentation agent -->
    <dependency>
      <groupId>co.elastic.otel</groupId>
      <artifactId>elastic-otel-java</artifactId>
      <version>${elastic-otel-java.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
