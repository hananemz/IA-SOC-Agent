# EDOT Python - Configuration OpenTelemetry obligatoire

# Nom du service tel qu'il apparaîtra dans Kibana/Elasticsearch
OTEL_SERVICE_NAME=mon-app-flask

# OTLP endpoint (endpoint OTLP direct ou EDOT Collector)
# Exemple Cloud Elastic : https://mon-projet.xxx.us-east-1.aws.cloud.es.io:443
OTEL_EXPORTER_OTLP_ENDPOINT=

# En-tête d'authentification (API Key Elastic Cloud ou token Bearer)
OTEL_EXPORTER_OTLP_HEADERS=Authorization=ApiKey <votre-api-key>
